# Allowlist: only the folders and files below go to GitHub.
# Everything else in this workshop folder (decks, papers, older prompt versions, automl_harness) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/data/
!/prompts/
!/slides/
!/qa/
!/genai_backup_v8/
!/genai_backup_titanic_v1/
!/automl_harness/

# never upload these, even inside allowed folders
.DS_Store
~$*
.ipynb_checkpoints/
__pycache__/
slides/*.pptx
genai_backup_*/reports/step00_data_copy.parquet

# automl_harness: instructor-machine scripts, notes and side experiments stay local
automl_harness/run_rerun_guarded.sh
